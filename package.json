{
  "name": "rdws",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24.9.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "local:init": "node scripts/local-init.mjs",
    "db:up": "node scripts/postgres.mjs up",
    "db:status": "node scripts/postgres.mjs status",
    "db:recreate": "node scripts/postgres.mjs recreate",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:generate": "pnpm --filter @rdws/db generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && pnpm --filter @rdws/console build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "dsh:model:import": "node scripts/dsh-model-import.mjs",
    "dsh:probe": "tsx scripts/dsh-probe.ts",
    "test:web-live": "playwright test --config playwright.web-live.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@rdws/contracts": "workspace:*",
    "@rdws/db": "workspace:*",
    "@rdws/dsh": "workspace:*",
    "@rdws/server": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "eslint": "10.15.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "yaml": "2.9.0",
    "@types/ws": "^8.18.1",
    "ws": "8.23.0"
  }
}
